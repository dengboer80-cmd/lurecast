page{background:#000;color:#f1f6f0;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,text,button,input,textarea,scroll-view{box-sizing:border-box}.page{padding:28rpx 24rpx 60rpx}.brand{font-size:42rpx;font-weight:700;letter-spacing:-1rpx}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#8c9c91;margin-bottom:12rpx}.title{font-size:44rpx;font-weight:650;line-height:1.4;margin:20rpx 0}.sub{font-size:23rpx;color:#99aa9e;line-height:1.8;margin:14rpx 0}.green{color:#c5f765}.card{background:#080b09;border:1rpx solid #283128;border-radius:24rpx;padding:24rpx;margin:20rpx 0}.row{display:flex;gap:14rpx;align-items:center;justify-content:space-between}.wrap{flex-wrap:wrap}.button,button{background:#101813;color:#f1f6f0;border:1rpx solid #38483d;border-radius:16rpx;font-size:26rpx;min-height:88rpx;padding:18rpx 24rpx;line-height:1.6;margin:10rpx 0}button::after{border:0}.primary{background:#c5f765;color:#10180a;font-weight:600}.small{font-size:22rpx}.empty{padding:36rpx 12rpx;color:#99aa9e;line-height:1.8}.input{background:#101813;color:#fff;border:1rpx solid #38483d;border-radius:14rpx;padding:20rpx;margin:12rpx 0;min-height:88rpx;width:100%;font-size:30rpx}.label{display:block;color:#99aa9e;font-size:24rpx;margin:22rpx 0 8rpx}.dates{white-space:nowrap;width:100%;margin:24rpx 0}.day{display:inline-block;text-align:center;min-width:150rpx;padding:20rpx 12rpx;margin-right:10rpx;border:1rpx solid #283128;border-radius:18rpx;color:#a8b7ac;background:#080b09}.day.selected{background:#c5f765;color:#10180a}.day text{display:block;line-height:1.8}.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.metric{margin:0;min-width:0}.metric .value{font-size:36rpx;overflow-wrap:anywhere;margin:14rpx 0}.trend{display:grid;grid-template-columns:140rpx 1fr 96rpx;gap:12rpx;align-items:center;border-bottom:1rpx solid #283128;padding:22rpx 0}.trend .sub{font-size:20rpx;margin:6rpx 0}.picker{border:1rpx solid #38483d;border-radius:14rpx;padding:20rpx;background:#101813;min-height:88rpx}.filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin:18rpx 0}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10rpx}.fishcard{padding:8rpx 4rpx 14rpx;position:relative;border:1rpx solid #283128;border-radius:16rpx;background:#080b09;text-align:center;min-width:0;margin:0;line-height:1.4}.fishcard.active{border:2rpx solid #c5f765}.fish-art{width:100%;height:132rpx;position:relative;overflow:hidden;background:#000;border-radius:12rpx}.fish-art image{position:absolute;max-width:none}.fishname{font-size:21rpx;line-height:1.5;min-height:64rpx;padding-top:8rpx;overflow-wrap:anywhere}.rank{position:absolute;top:6rpx;left:8rpx;font-size:18rpx;color:#9aa99a;z-index:1}.score{font-size:40rpx;color:#c5f765;font-weight:700}.bigscore{font-size:72rpx;color:#c5f765;font-weight:700}.pager{display:flex;justify-content:center;align-items:center;gap:20rpx;margin:20rpx 0}.pager button{font-size:22rpx;padding:16rpx}.reason{padding:14rpx 0;border-bottom:1rpx solid #283128;font-size:24rpx;color:#a8b7ac;line-height:1.8}.events{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx}.event{text-align:center;padding:20rpx;border:1rpx solid #283128;border-radius:18rpx}.event text{display:block;line-height:1.8}.chart{height:170rpx;display:flex;gap:6rpx;align-items:flex-end}.bar{flex:1;background:#c5f765;min-height:4rpx;border-radius:8rpx 8rpx 0 0}.tag{font-size:20rpx;color:#b9c9bb;padding:8rpx 12rpx;border:1rpx solid #38483d;border-radius:10rpx}.link{color:#c5f765;text-decoration:underline}.disabled{opacity:.45}
