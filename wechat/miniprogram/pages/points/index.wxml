<view class="page"><view class="title">本机钓点</view><view class="sub">仅记录你自行核实的地点；不表示允许垂钓。当前版本未接入公共钓场或地图服务。</view><view class="card"><input class="input" value="{{name}}" data-field="name" bindinput="input" placeholder="名称" maxlength="60"/><picker range="{{types}}" value="{{typeIndex}}" bindchange="type"><view class="picker">{{types[typeIndex]}}</view></picker><input class="input" value="{{lat}}" data-field="lat" bindinput="input" placeholder="WGS84纬度"/><input class="input" value="{{lng}}" data-field="lng" bindinput="input" placeholder="WGS84经度"/><button class="primary" bindtap="save">保存钓点</button></view><view wx:for="{{items}}" wx:key="id" class="card"><view>{{item.name}}</view><view class="sub">{{item.lat}}, {{item.lng}} · 未核实开放情况</view><view class="row"><button bindtap="use" data-index="{{index}}">查询天气</button><button bindtap="remove" data-index="{{index}}">删除</button></view></view></view>
