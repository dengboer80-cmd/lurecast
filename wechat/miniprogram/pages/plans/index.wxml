<view class="page plans-page">
<view class="eyebrow">LURECAST · MY CASTS</view>
<view class="section-heading"><view class="section-title">我的出钓</view><text class="small green">{{plans.length}} 个计划</text></view><view class="sub" wx:if="{{signedIn}}">已通过当前微信登录，计划和钓点保存在你的微信账号中。</view>
<view wx:if="{{signedIn && profile}}" class="card row profile">
 <image class="profile-avatar" src="{{profile.avatarPath}}" mode="aspectFill"/>
 <text class="profile-name">{{profile.nickname}}</text>
</view>
<view wx:if="{{signedIn && profileError}}" class="sub">{{profileError}}<button disabled="{{busy}}" bindtap="retryProfile">重新加载微信资料</button></view>
<form wx:if="{{signedIn && profileReady && !profile}}" class="card" bindsubmit="saveProfile">
 <view>设置微信资料</view>
 <view class="sub">首次保存的头像和昵称会存入你的 LureCast 账号，并在以后登录时显示。</view>
 <image wx:if="{{avatarDraft}}" class="profile-avatar" src="{{avatarDraft}}" mode="aspectFill"/>
 <button open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{busy}}">选择微信头像</button>
 <input class="input" name="nickname" type="nickname" value="{{nicknameDraft}}" bindblur="nicknameChange" maxlength="64" placeholder="点击输入框选择微信昵称" disabled="{{busy}}"/>
 <button class="primary" form-type="submit" disabled="{{busy}}">保存头像和昵称</button>
</form>
<button wx:if="{{signedIn}}" disabled="{{busy}}" bindtap="logout">退出同步，查看本机记录</button>
<view class="sub" wx:else>微信登录后，新建的计划和钓点可跨设备查看。已有本机记录可在退出同步后查看。</view>
<button wx:if="{{!signedIn}}" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="login">微信登录</button>
<button bindtap="points" disabled="{{busy}}">{{signedIn?'我的钓点':'本机钓点记录'}}</button>
<button class="primary" bindtap="record" disabled="{{busy}}">＋ 记录一次出钓</button><view class="card"><view>我的实钓记录</view><view class="green sub">已复盘 {{stats.count}} 次 · 有口 {{stats.contacts}} 次 · 有中鱼 {{stats.caught}} 次</view><view class="sub">未确认鱼口 {{stats.unknown}} 次 · 累计 {{stats.hours}} 小时 · {{stats.note}}</view><view class="sub" wx:for="{{stats.groups}}" wx:key="key">{{item.name}} · {{item.fish}}：{{item.count}}次记录，有口{{item.contacts}}次，{{item.hours}}小时</view></view>
<view wx:if="{{loadError}}" class="sub">{{loadError}}<button bindtap="refresh">重新加载</button></view>
<view wx:if="{{!busy && !loadError && !plans.length}}" class="empty">暂无出钓计划，请在首页选择地点和日期后添加。</view>
<view class="card plan-card" wx:for="{{plans}}" wx:key="id"><view class="plan-place">{{item.place.name}}</view><view class="sub plan-date">{{item.date}} · {{item.time}}</view><view wx:if="{{item.review}}" class="sub">目标鱼：{{item.review.targetName||'库内鱼种'}} {{item.review.fishType}} · {{item.review.minutes}}分钟 · {{item.review.contact==='yes'?'有口':item.review.contact==='no'?'无口':'鱼口未确认'}} · {{item.review.hooked||item.review.caught>0?'有中鱼':'未中鱼'}}<view>主要饵：{{item.review.bait}}</view></view><view wx:if="{{item.weather}}" class="sub">记录天气：{{item.weather.summary||'未获取'}}<view wx:if="{{item.weather.observed}}">现场补充：{{item.weather.observed}}</view><view>{{item.weather.source==='forecast'?'所选时段预报快照，非实测':item.weather.source==='manual'?'用户现场填写':'当时数据未获取'}} · {{item.weather.date}} {{item.weather.time}}</view></view>
<view wx:if="{{item.snapshot}}" class="snapshot"><view class="label">加入计划时的推荐（不会随预报刷新）</view><view class="sub">{{item.snapshot.fish}} · {{item.snapshot.score}}分 · {{item.snapshot.window}}</view><view class="sub">{{item.snapshot.weatherSummary}}</view><view class="sub">{{item.snapshot.bait}} · {{item.snapshot.confirmed?'当时已确认钓点鱼种':'当时鱼种未确认'}}</view></view>
<button bindtap="toggleReview" data-id="{{item.id}}">{{item.review?'查看／修改出钓复盘':'出钓结束 · 30秒复盘'}}</button>
<view wx:if="{{item.reviewOpen}}" class="review-form">
 <view class="label">本次目标鱼</view><picker range="{{item.reviewNames}}" value="{{item.reviewDraft.targetIndex}}" data-id="{{item.id}}" data-field="targetIndex" bindchange="reviewInput"><view class="picker">{{item.reviewNames[item.reviewDraft.targetIndex]}}</view></picker>
 <input class="input" value="{{item.reviewDraft.targetName}}" data-id="{{item.id}}" data-field="targetName" bindinput="reviewInput" maxlength="40" placeholder="或自填目标鱼名称（优先使用）"/><input class="input" value="{{item.reviewDraft.fishType}}" data-id="{{item.id}}" data-field="fishType" bindinput="reviewInput" maxlength="40" placeholder="可选：鱼种分类／当地俗名"/><view class="label">实际作钓时长（分钟）</view><input class="input" type="number" value="{{item.reviewDraft.minutes}}" data-id="{{item.id}}" data-field="minutes" bindinput="reviewInput" placeholder="例如120，不包括路上时间"/>
 <view class="label">是否有口</view><picker range="{{contacts}}" value="{{item.reviewDraft.contactIndex}}" data-id="{{item.id}}" data-field="contactIndex" bindchange="reviewInput"><view class="picker">{{contacts[item.reviewDraft.contactIndex]}}</view></picker>
 <view class="label">是否中鱼</view><picker range="{{hooks}}" value="{{item.reviewDraft.hookIndex}}" data-id="{{item.id}}" data-field="hookIndex" bindchange="reviewInput"><view class="picker">{{hooks[item.reviewDraft.hookIndex]}}</view></picker><view class="label">中鱼尾数（选填，未中鱼填0）</view><input class="input" type="number" value="{{item.reviewDraft.caught}}" data-id="{{item.id}}" data-field="caught" bindinput="reviewInput" placeholder="包括最后脱钩的中鱼，不含仅跟饵"/>
 <input class="input" value="{{item.reviewDraft.bait}}" data-id="{{item.id}}" data-field="bait" bindinput="reviewInput" maxlength="80" placeholder="主要拟饵／钩组"/>
 <textarea class="input" value="{{item.reviewDraft.note}}" data-id="{{item.id}}" data-field="note" bindinput="reviewInput" maxlength="300" placeholder="可选：水色、水位、有效操作、没口原因"/>
 <view class="sub">天气与地点沿用本计划；推荐快照是出发前参考，不是现场实测。空军记录同样有价值。</view>
 <button class="primary" disabled="{{busy}}" data-id="{{item.id}}" bindtap="saveReview">保存复盘</button>
</view><view class="label">出发时间</view><picker mode="time" value="{{item.time}}" data-id="{{item.id}}" data-field="time" bindchange="edit"><view class="picker">{{item.time}}</view></picker><textarea class="input" value="{{item.note}}" data-id="{{item.id}}" data-field="note" maxlength="300" placeholder="出钓备注" bindinput="edit"/><button class="primary" disabled="{{busy}}" bindtap="save" data-id="{{item.id}}">保存计划</button><view class="row"><button bindtap="weather" data-id="{{item.id}}">查看天气</button><button disabled="{{busy}}" bindtap="remove" data-id="{{item.id}}">移除</button></view></view><button bindtap="about">数据与隐私</button></view>
