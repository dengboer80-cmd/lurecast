<view class="page"><view class="eyebrow">LURECAST · 出钓日记</view><view class="title">记录一次出钓</view><view class="sub">{{signedIn?'保存到当前微信账号，记录默认私密。':'保存到本机；微信登录后可保存云端新记录。'}}</view>
<view class="card"><view class="label">钓点名称</view><input class="input" value="{{name}}" data-field="name" bindinput="input" maxlength="60" placeholder="自己给钓点起个名字"/>
<view class="label">定位地点</view><button bindtap="locations">{{place.name}} · 自由选择地点 ↗</button><button bindtap="points">从我的钓点选择</button><view class="sub">支持全国地点搜索和手机定位，无需填写经纬度。</view>
<view class="filters"><view><view class="label">出钓日期</view><picker mode="date" value="{{date}}" end="{{today}}" bindchange="date"><view class="picker">{{date}}</view></picker></view><view><view class="label">开始作钓时间</view><picker mode="time" value="{{time}}" bindchange="time"><view class="picker">{{time}}</view></picker></view></view>
<view class="label">目标鱼</view><picker range="{{fishNames}}" value="{{targetIndex}}" bindchange="target"><view class="picker">{{fishNames[targetIndex]}}</view></picker><input class="input" value="{{targetName}}" data-field="targetName" bindinput="input" maxlength="40" placeholder="也可自己填写鱼名，填写后优先使用"/><input class="input" value="{{fishType}}" data-field="fishType" bindinput="input" maxlength="40" placeholder="鱼种分类／当地俗名（选填）"/>
<view class="label">实际钓鱼时长（分钟）</view><input class="input" type="number" value="{{minutes}}" data-field="minutes" bindinput="input" placeholder="例如120"/>
<view class="filters"><view><view class="label">是否有口</view><picker range="{{contacts}}" value="{{contactIndex}}" bindchange="contact"><view class="picker">{{contacts[contactIndex]}}</view></picker></view><view><view class="label">是否中鱼</view><picker range="{{hooks}}" value="{{hookIndex}}" bindchange="hooked"><view class="picker">{{hooks[hookIndex]}}</view></picker></view></view>
<view class="label">主要饵</view><input class="input" value="{{bait}}" data-field="bait" bindinput="input" maxlength="80" placeholder="拟饵、饵料或钩组名称"/>
<view class="label">作钓备注（选填）</view><textarea class="input" value="{{note}}" data-field="note" bindinput="input" maxlength="300" placeholder="鱼口、操作、水色、水位等"/></view>
<view class="card"><view>当时的天气</view><view class="sub">{{weatherStatus}}</view><view wx:if="{{weather}}" class="green sub">{{weather.summary}}</view><view class="sub">自动获取的是所选时段预报，非现场实测。历史日期或接口不可用时，可手动填写。</view><button wx:if="{{weatherLoading}}" bindtap="skipWeather">跳过自动获取，手动填写</button><button wx:else bindtap="fetchWeather">重新获取天气</button><textarea class="input" value="{{observed}}" data-field="observed" bindinput="input" maxlength="200" placeholder="现场天气：例如阴天、小雨、微风、约18℃"/></view>
<button class="primary" loading="{{busy}}" disabled="{{busy || weatherLoading}}" bindtap="save">保存出钓记录</button></view>
