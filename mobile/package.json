{
  "name": "lurecast-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "npm run prepare:web && cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "prepare:web": "node scripts/prepare.mjs",
    "test": "npm run prepare:web && node tests/mobile.cjs",
    "ios:simulator": "bash scripts/ios-build.sh simulator",
    "ios:archive": "bash scripts/ios-build.sh archive",
    "ios:check": "node tests/ios-config.cjs",
    "ios:ipa": "bash scripts/ios-build.sh export",
    "build:pwa": "npm run prepare:web && node scripts/build-pwa.mjs",
    "test:pwa": "npm run build:pwa && node tests/pwa.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@sparticuz/chromium": "^153.0.0",
    "playwright": "^1.64.1",
    "plist": "^3.1.1",
    "xcode": "^3.0.1"
  }
}
